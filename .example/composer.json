{
    "name": "precision-soft/symfony-phpunit-example",
    "description": "A product catalogue slice whose test suite exercises every public capability of precision-soft/symfony-phpunit",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "doctrine/orm": "^3.0",
        "doctrine/persistence": "^3.0 || ^4.0",
        "symfony/event-dispatcher-contracts": "^3.0",
        "symfony/string": "^7.0 || ^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-mockery": "^2.0",
        "phpunit/phpunit": "^11.5",
        "precision-soft/symfony-phpunit": "*@dev",
        "symfony/framework-bundle": "^7.0 || ^8.0",
        "symfony/phpunit-bridge": "^7.0 || ^8.0",
        "symfony/translation-contracts": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "PrecisionSoft\\Symfony\\Phpunit\\Example\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PrecisionSoft\\Dev\\PhpStan\\": "../.dev/phpstan/",
            "PrecisionSoft\\Symfony\\Phpunit\\Example\\Test\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../",
            "options": {
                "symlink": true
            }
        }
    ],
    "scripts": {
        "test": "simple-phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "check": [
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
