{
    "name": "precision-soft/symfony-phpunit",
    "type": "library",
    "description": "Mockery-based mock container and test utilities for Symfony PHPUnit",
    "keywords": [
        "symfony",
        "phpunit",
        "mockery"
    ],
    "homepage": "https://github.com/precision-soft/symfony-phpunit",
    "license": "MIT",
    "authors": [
        {
            "name": "Adrian Jeledintan",
            "email": "adrian.jeledintan@precision-soft.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "mockery/mockery": "^1.0",
        "symfony/phpunit-bridge": "^7.0 || ^8.0",
        "symfony/string": "^7.0 || ^8.0"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.0 || ^3.0",
        "doctrine/orm": "^3.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-mockery": "^2.0",
        "phpunit/phpunit": "^11.5",
        "symfony/framework-bundle": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "PrecisionSoft\\Symfony\\Phpunit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PrecisionSoft\\Dev\\PhpStan\\": ".dev/phpstan/",
            "PrecisionSoft\\Symfony\\Phpunit\\Test\\": "tests/"
        }
    },
    "scripts": {
        "install-hooks": [
            "[ \"${COMPOSER_DEV_MODE:-0}\" -eq 1 ] && { [ -L .git/hooks ] && [ \"$(readlink .git/hooks)\" = ../.dev/git-hooks ] || { rm -rf .git/hooks && ln -s ../.dev/git-hooks .git/hooks; }; } || exit 0"
        ],
        "test": "simple-phpunit --exclude-group integration",
        "test-integration": "simple-phpunit --group integration",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "deps-audit": "@composer audit --locked",
        "mutation": "infection --threads=max --test-framework-options=\"--exclude-group=integration\" --initial-tests-php-options=\"-d pcov.enabled=1\"",
        "check": [
            "@cs-check",
            "@phpstan",
            "@test"
        ],
        "post-install-cmd": [
            "@install-hooks"
        ],
        "post-update-cmd": [
            "@install-hooks"
        ]
    },
    "suggest": {
        "doctrine/orm": "Required to use ManagerRegistryMock",
        "doctrine/doctrine-bundle": "Required to use ManagerRegistryMock"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.2"
        },
        "sort-packages": true
    }
}
